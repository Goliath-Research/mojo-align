#!/usr/bin/env bash
# bin/methylGrapher — mojo-align unified launcher.
#
# By default runs the Python engine (methylgrapher/engine/cli.py), the faithful
# 0.2.0 port with cutover patches. Set METHYLGRAPHER_ENGINE=mojo to run the Mojo
# CLI (methylgrapher/src/main.mojo). MojoFq2bamMeth always orchestrates via
# engine.fq2bam_meth (map kernel: fq2bam-meth/src/linear_mapper.mojo).
#
# Always runs from the repository root through `pixi run`.

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

export PATH="$HOME/.pixi/bin:$PATH"

cd "$REPO_ROOT"

# Mojo include paths for the packages (flat imports preserved).
MOJO_I=(
  -I gpu-common/src
  -I fq2bam-meth/src
  -I giraffe/src
  -I methylgrapher/src
  -I numeric/src
)

# Python: engine package under methylgrapher/; scripts for legacy helpers.
export PYTHONPATH="${REPO_ROOT}/methylgrapher:${REPO_ROOT}/giraffe/scripts:${REPO_ROOT}/giraffe/python:${REPO_ROOT}/fq2bam-meth/python:${REPO_ROOT}/gpu-common/python${PYTHONPATH:+:$PYTHONPATH}"

if [[ "${METHYLGRAPHER_ENGINE:-}" == "mojo" ]]; then
    # Mojo 1.1 eagerly emits reachable GPU kernels, so compilation must target
    # a supported production accelerator even when this host only has sm_50.
    # Operators can override this for another deployed architecture.
    TARGET_ACCELERATOR="${METHYLGRAPHER_TARGET_ACCELERATOR:-}"
    if [[ -z "$TARGET_ACCELERATOR" ]]; then
        if [[ -n "${METHYLGRAPHER_AMDGPU_ARCH:-}" ]]; then
            TARGET_ACCELERATOR="amdgpu:${METHYLGRAPHER_AMDGPU_ARCH}"
        else
            TARGET_ACCELERATOR="nvidia:sm_90"
        fi
    fi
    exec pixi run mojo run --target-accelerator "$TARGET_ACCELERATOR" \
        "${MOJO_I[@]}" methylgrapher/src/main.mojo "$@"
else
    exec pixi run python -m engine.cli "$@"
fi
